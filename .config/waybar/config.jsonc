{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 8,
    "margin": 0,

    // Translated texts: i18n/<language>.jsonc, selected by launch.sh
    "include": ["~/.config/waybar/i18n/current.jsonc"],

    "modules-left": ["custom/shutdown", "custom/neon", "custom/vseparator", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["network", "bluetooth", "pulseaudio", "custom/brightness", "battery", "clock"],

    "custom/shutdown": {
        "format": "⏻",
        "on-click": "~/.config/wofi/scripts/powermenu.sh",
        "tooltip": false
    },

    "custom/neon": {
        "format": "󰏘",
        "on-click": "~/.config/neon/pick.sh",
        "tooltip": false
    },

    "custom/vseparator": {
        "format": "|",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 3
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },

    "network": {
        "format-wifi": "󰤨 ",
        "format-ethernet": "󰈢 {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "on-click": "nmcli"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "foot -e bluetoothctl"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "custom/brightness": {
        "format": "󰃠 {}%",
        "signal": 8,
        "exec": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh get",
        "on-scroll-up": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh up",
        "on-scroll-down": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh down",
        "on-click": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh left_click",
        "on-click-right": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh right_click"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },

    "clock": {
        "format": "{:L%a, %d %b • %H:%M}",
        "format-alt": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "tooltip": true,
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<b>{}</b>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-middle": "shift_reset"
        }
    }
}
