{
    "layer": "top",
    "position": "top",
    "spacing": 15,
    "margin": 0,

    // Translated texts: i18n/<language>.jsonc, selected by launch.sh
    "include": ["~/.config/waybar/i18n/current.jsonc"],

    "modules-left": ["custom/shutdown", "custom/neon", "hyprland/workspaces"],
    "modules-right": ["network", "bluetooth", "pulseaudio", "custom/brightness", "battery", "custom/weather", "clock"],

    "custom/shutdown": {
        "format": "󰐥",
        "on-click": "~/.config/wofi/scripts/powermenu.sh",
        "tooltip": false
    },

    "custom/neon": {
        "format": "󰏘",
        "on-click": "~/.config/neon/pick.sh",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "on-click": "kitty -e nmtui"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "kitty -e bluetoothctl"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "custom/brightness": {
        "format": "󰃠 {}%",
        "signal": 8,
        "exec": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh get",
        "on-scroll-up": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh up",
        "on-scroll-down": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh down",
        "on-click": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh left_click",
        "on-click-right": "$HOME/.config/waybar/scripts/brightness-per-monitor.sh right_click"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰂎", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
        "format-charging": "󰂄 {capacity}%",
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    },

    // Weather from Open-Meteo, for the location of your IP or the city in
    // weather.conf (right click to change it)
    "custom/weather": {
        "exec": "$HOME/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 900,
        "signal": 9,
        "on-click": "$HOME/.config/waybar/scripts/weather.sh refresh",
        "on-click-right": "$HOME/.config/waybar/scripts/weather-city.sh"
    },

    "clock": {
        "tooltip-format": "<tt>{calendar}</tt>",
        "tooltip": true,
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "format": {
                "today": "<b>{}</b>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down",
            "on-click-middle": "shift_reset"
        }
    }
}
