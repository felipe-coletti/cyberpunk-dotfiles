{
    "network": {
        "format-linked": "󰈁 {ifname} (لا يوجد IP)"
    },

    "pulseaudio": {
        "format-muted": "󰝟 صامت",
        "tooltip-format": "{desc}\nالتمرير: ضبط مستوى الصوت\nالنقر: كتم/إلغاء الكتم"
    },

    "custom/brightness": {
        "tooltip-format": "سطوع الشاشة\nالتمرير: ضبط\nالنقر الأيسر: 100%\nالنقر الأيمن: 0%"
    },

    "clock": {
        "format": "{:%H:%M\n%d/%m/%Y}",
        "format-alt": "{:L%H:%M\n%A، %d/%m/%Y}"
    }
}
